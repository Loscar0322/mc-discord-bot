# 複製成 .env 後填入實際值（.env 不會被提交）
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
# 選填：即時狀態訊息要放的頻道，留空就跟通知同一個頻道
STATUS_CHANNEL_ID=
SERVER_ADDRESS=
# 選填（mc-bot VM）：/start、/stop 要開關的 VM，預設 asia-east1-b / minecraft-server
GCP_ZONE=
GCP_INSTANCE=
# 選填：除了有「管理伺服器」權限的人，還能用 /start、/stop 的身分組／使用者 ID（逗號分隔）
CONTROL_ROLE_IDS=
CONTROL_USER_IDS=
CF_PAGE_URL=
CF_EXCLUDE_MODS=
WHITELIST=
